# 任意目录层级的 macOS 元数据。/ macOS metadata at any directory depth.
.DS_Store

# 应用本地依赖与生成的构建输出。/ Local application dependencies and generated build output.
/slots-game/web/node_modules/
/slots-game/web/dist/
/slots-game/web/coverage/
/slots-game/web/release-nginx.conf
/slots-game/server/coverage.out
*.tsbuildinfo

# 自动生成的发布与一致性验证证据。/ Automatically generated release and conformance evidence.
/.artifacts/
/slots-game/.artifacts/

# 本地分析过程中的临时工作文件。 / English: Temporary files produced during local analysis.
/slots-game/.tmp-pass*

# 本地录制源片、剪辑工作区与私人求职材料不得进入游戏仓库。/ Local recording sources, editing workspaces, and private job-search documents must not enter the game repository.
/PrimalRampage_Trailer_16x9_1080p.mp4
/output/
/tmp/
/*-个人简历.md
/*-面试问题与参考答案.md

# 原始浏览器抓包和会话数据只允许存放在仓库外归档中。/ Raw browser captures and session data belong only in an archive outside the repository.
/slots-game/captures/primal-rampage/*

# 本地配置、运行状态、发布审批和密钥不得进入 Git。/ Local configuration, runtime state, release approvals, and keys must never enter Git.
.env
.env.*
!.env.example
!*.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
**/.secrets/
**/.state/
/secrets/
/state/
/slots-game/deploy/local-production/secrets/
/slots-game/deploy/local-production/state/
**/release-asset-approval*.json
**/*release_asset_approval*.json

# 只放行明确命名的公开测试证书与公钥；任何 private/key 文件仍保持拒绝。/ Allow only explicitly named public test certificates and keys; every private/key file remains denied.
!/slots-game/server/**/testdata/*.public.pem
!/slots-game/server/**/testdata/*.crt
!/slots-game/server/**/fixtures/*.public.pem
!/slots-game/server/**/fixtures/*.crt
