# 任意目录层级的 macOS 元数据。
.DS_Store

# 应用本地依赖与生成的构建输出。
/slots-game/web/node_modules/
/slots-game/web/dist/
/slots-game/web/coverage/
/slots-game/web/release-nginx.conf
/slots-game/server/coverage.out
*.tsbuildinfo

# 自动生成的发布与一致性验证证据。
/.artifacts/
/slots-game/.artifacts/

# 本地分析过程中的临时工作文件。
/slots-game/.tmp-pass*

# 原始浏览器抓包和会话数据只允许存放在仓库外归档中。
/slots-game/captures/primal-rampage/*

# 本地配置、运行状态、发布审批和密钥不得进入 Git。
.env
.env.*
!.env.example
!*.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
**/.secrets/
**/.state/
/secrets/
/state/
/slots-game/deploy/local-production/secrets/
/slots-game/deploy/local-production/state/
**/release-asset-approval*.json
**/*release_asset_approval*.json

# 只放行明确命名的公开测试证书/公钥；任何 private/key 文件仍保持拒绝。
!/slots-game/server/**/testdata/*.public.pem
!/slots-game/server/**/testdata/*.crt
!/slots-game/server/**/fixtures/*.public.pem
!/slots-game/server/**/fixtures/*.crt
