# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

ARG GO_IMAGE=golang:1.26.6-bookworm@sha256:116d58cbd88c1297624acc6e967a060012422bacf9930927e23fb719189c6f36
ARG RUNTIME_IMAGE=gcr.io/distroless/static-debian12:nonroot@sha256:1b7b9f0f0e0a1d2155f531db587cc48ec26aaf97ab64364225f5bf18a054e66a

FROM ${GO_IMAGE} AS build
WORKDIR /src/server
COPY server/go.mod server/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY server/ ./
COPY tools/container-helpers/secret-env/main.go /src/tools/secret-env.go
COPY tools/container-helpers/service-probe/main.go /src/tools/service-probe.go
COPY tools/container-helpers/secret-materializer/main.go /src/tools/secret-materializer.go
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    --network=none \
    go run ./scripts/third-party-notices --check && \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -buildvcs=false -ldflags='-s -w' -o /out/rgs-server ./cmd/rgs-server && \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -buildvcs=false -ldflags='-s -w' -o /out/rgs-migrator ./cmd/rgs-migrator && \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -buildvcs=false -ldflags='-s -w' -o /out/secret-env /src/tools/secret-env.go && \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -buildvcs=false -ldflags='-s -w' -o /out/service-probe /src/tools/service-probe.go && \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -buildvcs=false -ldflags='-s -w' -o /out/secret-materializer /src/tools/secret-materializer.go

FROM ${RUNTIME_IMAGE} AS runtime-base
ARG OCI_IMAGE_CREATED
ARG OCI_IMAGE_REVISION
ARG OCI_IMAGE_SOURCE
ARG OCI_IMAGE_VERSION
LABEL org.opencontainers.image.created="${OCI_IMAGE_CREATED}" \
      org.opencontainers.image.revision="${OCI_IMAGE_REVISION}" \
      org.opencontainers.image.source="${OCI_IMAGE_SOURCE}" \
      org.opencontainers.image.url="${OCI_IMAGE_SOURCE}" \
      org.opencontainers.image.version="${OCI_IMAGE_VERSION}" \
      org.opencontainers.image.vendor="slots-game" \
      com.slots-game.deployment.profile="cluster-production"
USER nonroot:nonroot

FROM runtime-base AS rgs-runtime
LABEL org.opencontainers.image.title="slots-rgs-runtime" \
      org.opencontainers.image.description="RGS 集群生产运行服务"
COPY --from=build --chown=nonroot:nonroot /out/rgs-server /rgs-server
COPY --from=build --chown=nonroot:nonroot /out/secret-env /secret-env
COPY --from=build --chown=nonroot:nonroot /out/service-probe /service-probe
COPY --from=build --chown=nonroot:nonroot /out/secret-materializer /secret-materializer
COPY --from=build --chown=nonroot:nonroot /src/server/THIRD_PARTY_NOTICES.txt /THIRD_PARTY_NOTICES.txt
EXPOSE 8080 8081
ENTRYPOINT ["/secret-env", "RGS_DATABASE_URL", "/rgs-server"]

FROM runtime-base AS rgs-migrator
LABEL org.opencontainers.image.title="slots-rgs-migrator" \
      org.opencontainers.image.description="RGS 集群生产数据库迁移器"
COPY --from=build --chown=nonroot:nonroot /out/rgs-migrator /rgs-migrator
COPY --from=build --chown=nonroot:nonroot /out/secret-env /secret-env
COPY --from=build --chown=nonroot:nonroot /src/server/THIRD_PARTY_NOTICES.txt /THIRD_PARTY_NOTICES.txt
ENTRYPOINT ["/secret-env", "RGS_MIGRATOR_DATABASE_URL", "/rgs-migrator"]
