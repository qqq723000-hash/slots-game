# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:1.30.4-alpine3.24-slim@sha256:e88d990b349df8cf4aa82f16642d7a23375016638c9ace4e5c6ca25028e62e65
FROM ${NGINX_IMAGE}
ARG OCI_IMAGE_CREATED
ARG OCI_IMAGE_REVISION
ARG OCI_IMAGE_SOURCE
ARG OCI_IMAGE_VERSION
LABEL org.opencontainers.image.created="${OCI_IMAGE_CREATED}" \
      org.opencontainers.image.revision="${OCI_IMAGE_REVISION}" \
      org.opencontainers.image.source="${OCI_IMAGE_SOURCE}" \
      org.opencontainers.image.url="${OCI_IMAGE_SOURCE}" \
      org.opencontainers.image.version="${OCI_IMAGE_VERSION}" \
      org.opencontainers.image.vendor="slots-game" \
      org.opencontainers.image.title="slots-web" \
      org.opencontainers.image.description="Slots Game 本机集成验收静态 Web" \
      com.slots-game.deployment.profile="local-production"

COPY --chown=101:101 web/release-nginx.conf /etc/nginx/conf.d/default.conf
COPY --chown=101:101 web/dist/ /usr/share/nginx/html/
COPY --chown=0:0 web/dist/THIRD_PARTY_NOTICES.txt /THIRD_PARTY_NOTICES.txt

RUN --network=none test -s /THIRD_PARTY_NOTICES.txt && \
    cmp /THIRD_PARTY_NOTICES.txt /usr/share/nginx/html/THIRD_PARTY_NOTICES.txt
RUN --network=none nginx -t

EXPOSE 8080
USER 101:101
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD ["wget", "-q", "-T", "2", "-O", "/dev/null", "http://127.0.0.1:8080/healthz"]
