      "keepTime": true,
      "tags": [],
      "targetBlank": true,
      "title": "RGS 运维手册",
      "tooltip": "部署时必须渲染为受控 runbook 地址",
      "type": "link",
      "url": "__RUNBOOK_BASE_URL__/rgs-observability"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "rgs-prometheus"
      },
      "description": "同时显示独立运维监听器可抓取状态和低基数 rgs_ready 就绪状态；业务接流仍必须由编排器探测 /readyz。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "DOWN"
                },
                "1": {
                  "color": "green",
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
