configuration = {
  contract_version    = "1.0.0"
  project_name        = "slots"
  expected_account_id = "REPLACE_WITH_STAGING_ACCOUNT_ID"
  aws_region          = "ap-southeast-1"
  application_namespace = "slots-staging"
  helm_release_name     = "slots"
  availability_zones  = ["ap-southeast-1a", "ap-southeast-1b", "ap-southeast-1c"]

  vpc_cidr             = "10.20.0.0/16"
  public_subnet_cidrs  = ["10.20.0.0/24", "10.20.1.0/24", "10.20.2.0/24"]
  private_subnet_cidrs = ["10.20.10.0/24", "10.20.11.0/24", "10.20.12.0/24"]
  data_subnet_cidrs    = ["10.20.20.0/24", "10.20.21.0/24", "10.20.22.0/24"]
  edge_ingress_cidrs   = ["REPLACE_WITH_APPROVED_EDGE_CIDR"]
  enable_nat_gateway_per_az = true

  cluster_admin_principal_arns  = ["REPLACE_WITH_STAGING_EKS_ADMIN_ROLE_ARN"]
  alert_delivery_principal_arns = ["REPLACE_WITH_STAGING_ONCALL_ROLE_ARN"]

  kubernetes_version = "REPLACE_WITH_SUPPORTED_EKS_MINOR"
  eks_addon_versions = {
    amazon-cloudwatch-observability = "REPLACE_WITH_EXACT_ADDON_VERSION"
    coredns                = "REPLACE_WITH_EXACT_ADDON_VERSION"
    eks-pod-identity-agent = "REPLACE_WITH_EXACT_ADDON_VERSION"
    kube-proxy             = "REPLACE_WITH_EXACT_ADDON_VERSION"
    metrics-server         = "REPLACE_WITH_EXACT_ADDON_VERSION"
    vpc-cni                = "REPLACE_WITH_EXACT_ADDON_VERSION"
  }
  platform_addon_versions = {
    aws-load-balancer-controller = "REPLACE_APPROVED_EXACT_SEMVER"
    cluster-autoscaler            = "REPLACE_APPROVED_EXACT_SEMVER"
    external-secrets             = "REPLACE_APPROVED_EXACT_SEMVER"
    kube-prometheus-stack        = "REPLACE_APPROVED_EXACT_SEMVER"
    prometheus-agent             = "REPLACE_APPROVED_EXACT_SEMVER"
  }
  cluster_autoscaler_image_tag = "REPLACE_WITH_EXACT_V1_XX_PATCH"
  node_instance_types  = ["m7i.large"]
  node_min_size        = 2
  node_desired_size    = 3
  node_max_size        = 6
  node_volume_size_gib = 100

  rds_engine_version            = "REPLACE_WITH_APPROVED_POSTGRES_VERSION"
  rds_parameter_group_family    = "REPLACE_WITH_MATCHING_PARAMETER_FAMILY"
  rds_instance_class            = "db.m7g.large"
  rds_allocated_storage_gib     = 200
  rds_max_allocated_storage_gib = 500
  rds_multi_az                  = true
  rds_deletion_protection       = true
  rds_backup_retention_days     = 14
  rds_alarm_thresholds = {
    cpu_utilization_percent   = 70
    database_connections     = 200
    freeable_memory_bytes    = 1073741824
    free_storage_space_bytes = 42949672960
    read_latency_seconds     = 0.020
    write_latency_seconds    = 0.020
    disk_queue_depth         = 32
  }

  valkey_engine_version = "7.2"
  valkey_node_type      = "cache.m7g.large"
  valkey_alarm_thresholds = {
    engine_cpu_utilization_percent                    = 65
    database_capacity_usage_counted_for_evict_percent = 70
    current_connections                               = 500
    replication_lag_seconds                           = 1
    eval_based_commands_latency_microseconds          = 25000
  }
  valkey_active_slot    = "a"
  valkey_rotation_mode  = "steady"
  valkey_password_fingerprint_a = "REPLACE_WITH_SHA256_OF_VALKEY_PASSWORD_A"
  valkey_password_fingerprint_b = "REPLACE_WITH_SHA256_OF_VALKEY_PASSWORD_B"
  valkey_password_version_a = 1
  valkey_password_version_b = 1
  valkey_password_reset_approvals = {}
  valkey_hmac_maintenance_approval = null
  shared_admission_hmac_key_fingerprint = "REPLACE_WITH_SHA256_OF_CANONICAL_BASE64_HMAC_KEY"
  valkey_secret_version = 1
  application_secret_versions = {
    api-runtime-assets    = 1
    migrator-database     = 1
    operations-bearer     = 1
    runtime-database      = 1
    worker-runtime-assets = 1
  }

  api_waf_rate_limits = {
    public_requests_per_minute = 12000
    spin_requests_per_minute   = 600
    launch_requests_per_minute = 120
  }
  api_waf_rate_rule_rollouts = {
    launch-rate-limit = {
      action             = "count"
      evidence_reference = "observation-pending"
    }
    public-api-rate-limit = {
      action             = "count"
      evidence_reference = "observation-pending"
    }
    spin-rate-limit = {
      action             = "count"
      evidence_reference = "observation-pending"
    }
  }
  api_waf_header_size_rule_rollout = {
    action             = "count"
    evidence_reference = "observation-pending"
  }
  api_waf_alarm_thresholds = {
    blocked_requests_per_minute = 1000
    allowed_requests_per_minute = 100000
  }
  api_waf_managed_rule_rollout = {
    action             = "count"
    evidence_reference = "observation-pending"
  }
  api_waf_managed_rule_versions = {
    amazon-ip-reputation = "REPLACE_WITH_EXACT_AWS_MANAGED_RULE_VERSION"
    common               = "REPLACE_WITH_EXACT_AWS_MANAGED_RULE_VERSION"
    known-bad-inputs     = "REPLACE_WITH_EXACT_AWS_MANAGED_RULE_VERSION"
    sqli                 = "REPLACE_WITH_EXACT_AWS_MANAGED_RULE_VERSION"
  }
  waf_rollout_evidence_kms_key_arn = "REPLACE_WITH_WAF_EVIDENCE_KMS_KEY_ARN"

  web_bucket_name                    = "replace-with-unique-staging-web-bucket"
  cloudfront_log_bucket_name         = "replace-with-unique-staging-cloudfront-log-bucket"
  web_domain_name                    = "slots.staging.example.com"
  cloudfront_acm_certificate_arn     = "REPLACE_WITH_US_EAST_1_ACM_CERTIFICATE_ARN"
  regional_acm_certificate_arn       = "REPLACE_WITH_REGIONAL_ACM_CERTIFICATE_ARN"
  alb_access_log_bucket_name         = "replace-with-approved-staging-alb-access-log-bucket"
  alb_access_log_prefix              = "slots-staging"
  cloudfront_waf_web_acl_arn         = "REPLACE_WITH_GLOBAL_WAF_WEB_ACL_ARN"
  cloudfront_waf_rate_limit_per_minute = 12000
  cloudfront_waf_rate_rule_rollout = {
    action             = "count"
    evidence_reference = "observation-pending"
  }
  cloudfront_waf_log_group_name        = "aws-waf-logs-slots-staging-web"
  cloudfront_waf_managed_rule_rollout = {
    action             = "count"
    evidence_reference = "observation-pending"
  }
  cloudfront_waf_managed_rule_versions = {
    amazon-ip-reputation = "REPLACE_WITH_EXACT_AWS_MANAGED_RULE_VERSION"
    common               = "REPLACE_WITH_EXACT_AWS_MANAGED_RULE_VERSION"
    known-bad-inputs     = "REPLACE_WITH_EXACT_AWS_MANAGED_RULE_VERSION"
  }
  web_content_security_policy        = "REPLACE_WITH_CSP_FROM_VERIFIED_WEB_DIGEST"
  cloudfront_price_class             = "PriceClass_100"

  archive_bucket_name     = "replace-with-unique-staging-archive-bucket"
  archive_retention_days  = 365
  archive_deep_after_days = 90

  backup_retention_days                 = 90
  backup_enable_vault_lock              = false
  backup_vault_lock_changeable_for_days = 7
  backup_copy_destination_vault_arn     = ""
  backup_copy_source_account_ids        = []

  ecr_untagged_retention_days   = 90
  log_retention_days            = 90
  cloudfront_log_retention_days = 180

  additional_tags = {
    CostCenter = "REPLACE_WITH_COST_CENTER"
    Owner      = "REPLACE_WITH_TEAM"
  }
}
