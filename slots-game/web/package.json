{
  "name": "primal-rampage-web",
  "version": "1.2.3",
  "description": "Primal Rampage production browser client.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "assets:provenance-check": "node scripts/verify-asset-provenance.mjs",
    "assets:generate-streaming-packages": "node scripts/generate-streaming-package-manifests.mjs",
    "assets:check-streaming-packages": "node scripts/generate-streaming-package-manifests.mjs --check",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run licenses:check-artifacts && node scripts/finalize-production-assets.mjs && node scripts/verify-production-javascript-bundles.mjs",
    "build:determinism-check": "node scripts/verify-deterministic-release-build.mjs",
    "build:release": "npm run build && node scripts/verify-release-asset-approval.mjs",
    "build:assets-check": "node scripts/finalize-production-assets.mjs --check",
    "build:bundle-check": "node scripts/verify-production-javascript-bundles.mjs",
    "build:browser-smoke": "node scripts/verify-production-browser-bootstrap.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs --write",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
    "licenses:check-artifacts": "node scripts/generate-third-party-notices.mjs --check-artifacts",
    "licenses:test": "node scripts/test-third-party-notices.mjs",
    "prebuild": "npm run licenses:check && npm run assets:provenance-check",
    "pretest": "npm run licenses:test && npm run licenses:check && npm run assets:provenance-check",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pixi-spine/base": "3.1.0",
    "@pixi-spine/runtime-4.1": "3.1.0",
    "@pixi/unsafe-eval": "6.5.2",
    "pixi.js": "6.5.2"
  },
  "devDependencies": {
    "es-module-lexer": "2.3.1",
    "typescript": "5.6.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@pixi/app": "6.5.2",
    "@pixi/constants": "6.5.2",
    "@pixi/core": "6.5.2",
    "@pixi/display": "6.5.2",
    "@pixi/extensions": "6.5.2",
    "@pixi/graphics": "6.5.2",
    "@pixi/loaders": "6.5.2",
    "@pixi/math": "6.5.2",
    "@pixi/mesh": "6.5.2",
    "@pixi/mesh-extras": "6.5.2",
    "@pixi/runner": "6.5.2",
    "@pixi/settings": "6.5.2",
    "@pixi/sprite": "6.5.2",
    "@pixi/ticker": "6.5.2",
    "@pixi/utils": "6.5.2",
    "@pixi-spine/base": "3.1.0",
    "@pixi-spine/loader-base": "3.1.0",
    "@pixi-spine/loader-uni": "3.1.0",
    "@pixi-spine/runtime-3.7": "3.1.0",
    "@pixi-spine/runtime-3.8": "3.1.0",
    "@pixi-spine/runtime-4.1": "3.1.0"
  }
}
